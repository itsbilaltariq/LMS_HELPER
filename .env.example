# ==========================================
# NUST LMS Helper Environment Configuration
# ==========================================

# Application Security
APP_ENV=development
APP_SECRET=change-me-to-a-32-byte-hex-or-base64-random-secret
FERNET_KEY=change-me-to-a-valid-fernet-key-generate-via-cryptography
SESSION_COOKIE_NAME=__Host-session
CSRF_COOKIE_NAME=__Host-csrf
SECURE_COOKIES=false # Set to true in production behind HTTPS

# Database & Queue
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nust_lms_db
REDIS_URL=redis://localhost:6379/0

# LLM Engine: Groq Cloud API (Replace Claude)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_PARSER_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS_PER_JOB=100000

# Target LMS: National University of Sciences and Technology (NUST)
LMS_BASE_URL=https://lms.nust.edu.pk
LMS_LOGIN_URL=https://lms.nust.edu.pk/login/index.php
LMS_RATE_LIMIT_DELAY_SECONDS=2.0

# Sandbox & Execution Limits
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=512
